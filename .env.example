# ==============================================================================
# Pulse Agent Environment Configuration Example
# Copy to `.env` (never commit `.env` or files under `private/`)
# ==============================================================================

# --- Core Gateway & Security ---
AGENT_TOKEN=replace-with-strong-random-device-token
BRAIN_ENGINE=dsh
DS_CLAW_PUBLIC_URL=https://your-domain.example.com/proactive-agent

# --- LLM Upstream (OpenAI-compatible / DeepSeek) ---
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=replace-with-your-api-key

# --- Node DSH Brain Sidecar ---
DSH_BRAIN_HOST=127.0.0.1
DSH_BRAIN_PORT=18199
DSH_BRAIN_DATA_DIR=./server/data/dsh_sessions

# --- Cloud Workstation SSRF Guard (comma-separated hostnames/public IPs) ---
PUBLIC_BLOCKED_HOSTS=your-domain.example.com
PULSE_PUBLIC_HOST=your-domain.example.com

# --- Desktop DSH Plugin ---
PULSE_SERVER_URL=http://127.0.0.1:18190
DS_CLAW_LOCAL_PORT=18195

# --- Optional Private Host Deployment (`scripts/deploy_vps.py` & `publish_apk.py`) ---
# You may also store these locally in gitignored `private/deploy.json`.
PULSE_SSH_HOST=your-ssh-host-alias
PULSE_PUBLIC_BASE_URL=https://your-domain.example.com/proactive-agent
